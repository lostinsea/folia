# Refuse to install on a Node version this project cannot build or run with,
# instead of failing much later with an error that points somewhere else.
#
# Electron does not ship its binary on npm; a small shim downloads the real
# ~100MB build. That downloader is @electron/get, which from Electron 43 is pure
# ESM and declares `engines.node >= 22.12.0`, because `require()`-ing an ESM
# module only became possible in Node 22.12.
#
# Electron 43 also removed the `postinstall` hook that used to perform that
# download (Electron 41 had `"postinstall": "node install.js"`; 43 declares no
# scripts at all - part of the ecosystem-wide move away from install scripts,
# the same shift that gave npm 11 its `allowScripts` gate). The download now
# happens lazily on first use, from index.js. That is better for supply-chain
# safety, but it also means a too-old Node no longer fails during `npm install`:
# it fails the first time someone runs `npm start`, with a bare ERR_REQUIRE_ESM
# raised inside a dependency, giving no hint that the Node version is the cause.
#
# engine-strict pulls that failure back to install time, as an explicit
# EBADENGINE that names the required range.
#
# This concerns only the *downloader*. Electron bundles its own Node (43 ships
# Node 24), so the application itself never runs on the Node found in PATH.
#
# See .nvmrc for the version this project is developed against: `nvm use`.
engine-strict=true
