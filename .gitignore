# Dependencies
node_modules/

# Build outputs
dist/
build/
*.exe
*.msi

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local

# Package manager
# package-lock.json is deliberately NOT ignored: it is the only record of the
# exact dependency tree that was audited, and the app vendors marked, mermaid
# and DOMPurify straight out of node_modules at postinstall - so the lockfile
# now determines what actually ships to users, not just what developers build
# with. Ignoring it would make `npm audit` results unreproducible.
yarn.lock
pnpm-lock.yaml

# Scratch test documents and one-off probe scripts, which get written at the
# repo root constantly and must never be committed. Anchored with a leading
# slash so they apply to the ROOT ONLY: the real suites live in test/ and are
# tracked normally. That replaced a blanket `test-*.js` plus a growing list of
# `!test-whatever.js` exceptions, which was one forgotten line away from
# silently leaving a new suite untracked - and did once list a suite
# (test-translate-network.js) that no longer exists.
/test-*.md
/test-*.js
/probe-*.js
/tmp-*.js

# Written by the popup and mermaid suites so a redirected run is still
# inspectable - Electron drops buffered stdout on app.exit().
test-popup-results.txt
test-mermaid-results.txt
test-visual-results.txt
test-startup-perf-results.txt
test-search-results.txt
test-render-patch-results.txt
test-table-display-results.txt

# Scratch benchmark output. The .lock covers the file the runner leaves behind
# when it is killed mid-run, which bench-*.txt does not match and which was
# committed once by accident.
bench-*.txt
bench-*.txt.lock

# Screenshots are debugging artifacts, never baselines - see test-visual-utils.js
screenshots/

# Optional local fonts (users can download separately)
fonts/*.ttf
fonts/*.woff
fonts/*.woff2
# The OFL copy that scripts/vendor-libs.js places beside the fonts is a build
# output too. The tracked source of truth is assets/fonts/LICENSE-FiraCode.txt;
# committing the copy would leave two files that must agree by discipline, which
# is exactly how LICENSE and LICENSE.txt came to disagree.
fonts/LICENSE-FiraCode.txt
!fonts/README.md

# Runtime libraries copied out of node_modules by scripts/vendor-libs.js on
# postinstall. Generated, not authored - the versions are pinned by
# package-lock.json, so committing them would just duplicate node_modules.
libs/vendor/

# Claude Code documentation (local only)
CLAUDE.md
# Agent working directories. Taken from upstream 7e48d9f; the other two paths
# in that commit are NOT taken - `tests-electronics/` belongs to upstream's
# tscircuit work, and `ss/` is upstream's screenshot directory, whereas this
# fork writes test artifacts to `screenshots/` (already ignored above).
# `.cursor/` was inherited as a TRACKED rules directory and deleted: its rules
# contradicted how this repo actually works, and .github/copilot-instructions.md
# is now the single source of agent guidance. Ignored so it cannot drift back.
.claude/
.cursor/

# Windows null device files
nul

# Temporary files
tmp/
temp-*.html

# Build artifacts
release-artifacts/
linux-builds/
