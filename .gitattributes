# Without this, git's core.safecrlf guard rejects `git add` for any file that is
# LF in the working tree on a machine with core.autocrlf=true, because the
# LF -> repo -> CRLF round trip is not reversible. Several files here are written
# with LF by tooling regardless of platform, so pinning their end-of-line form
# is more honest than converting them by hand after every regeneration.

# npm rewrites these with LF on every install / `npm pkg set`, on every platform.
package.json text eol=lf
package-lock.json text eol=lf

# Read by version managers and by CI setup-node actions, which expect LF.
.nvmrc text eol=lf
.npmrc text eol=lf

# Generated by scripts/generate-notices.js, which writes LF on every platform.
# Without this pin, core.autocrlf=true hands a fresh checkout a CRLF copy while
# the generator keeps producing LF, so test-packaging.js's byte-for-byte
# staleness comparison fails on a clean clone and `npm run notices` cannot fix
# it - regenerating writes LF, git converts it straight back to CRLF, forever.
THIRD-PARTY-NOTICES.md text eol=lf

# Generated by scripts/generate-logo.js, which likewise writes LF everywhere.
# This one announced itself the hard way: `git add -A` ABORTED on safecrlf, and
# because the add aborted, the commit that followed captured only the files that
# happened to be staged already - a silently partial commit. The pin is the same
# fix as the notices above; the lesson is that an aborted `add` does not abort
# the `commit` after it.
assets/logo.svg text eol=lf

# Third-party licence texts, copied VERBATIM from their upstream sources
# (assets/fonts/LICENSE-FiraCode.txt is the SIL OFL as published; the Tabulator
# licence comes out of `npm pack tabulator-tables@6.2.5`). Their provenance is
# established by byte-for-byte comparison against the upstream artifact, so an
# end-of-line rewrite on checkout would break that verification and, for the
# OFL, alter the file that clause 2 requires to travel with the font binaries.
# Reproducing someone else's licence is the one place where "git will normalise
# it" is the wrong answer.
assets/fonts/LICENSE-FiraCode.txt text eol=lf
libs/tabulator/LICENSE text eol=lf

# Shell scripts must be LF or they fail on Linux and macOS with an unhelpful
# "bad interpreter" error when the shebang line ends in a stray carriage return.
*.sh text eol=lf

# Binary assets: never apply end-of-line conversion.
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.woff binary
*.woff2 binary
