{
  "name": "folia",
  "version": "0.1.0",
  "productName": "Folia",
  "description": "Folia - a fast, offline markdown viewer with tabs, Mermaid diagrams and live reload",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor-libs.js",
    "vendor": "node scripts/vendor-libs.js",
    "notices": "node scripts/generate-notices.js",
    "build": "electron-builder --win portable --publish never",
    "build-installer": "electron-builder --win nsis --publish never",
    "build-all": "electron-builder --win --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "build-linux-appimage": "electron-builder --linux AppImage --publish never",
    "build-linux-deb": "electron-builder --linux deb --publish never",
    "build-mac": "electron-builder --mac --publish never",
    "release": "node scripts/release.js",
    "test:tabs": "electron test/test-tab-refresh.js",
    "start-dev": "NODE_ENV=development electron .",
    "test:security": "electron test/test-render-security.js",
    "test:popups": "electron test/test-popup-security.js",
    "test:packaging": "node test/test-packaging.js",
    "test:migration": "node test/test-userdata-migration.js",
    "test:mermaid": "electron test/test-mermaid-render.js",
    "test:visual": "electron test/test-visual-utils-selfcheck.js",
    "test:startup": "electron test/test-startup-perf.js",
    "test:search": "electron test/test-search.js",
    "test:patch": "electron test/test-render-patch.js",
    "test:corpus": "node --check bench/run.js && node --check bench/corpus.js && node bench/verify.js",
    "bench": "electron bench/run.js",
    "test": "npm run test:packaging && npm run test:migration && npm run test:corpus && npm run test:startup && npm run test:tabs && npm run test:security && npm run test:popups && npm run test:visual && npm run test:search && npm run test:mermaid && npm run test:patch && npm run test:tables",
    "test:tables": "node --check test/test-table-display.js && electron test/test-table-display.js"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "mermaid",
    "folia"
  ],
  "author": {
    "name": "lostinsea"
  },
  "license": "MIT",
  "homepage": "https://github.com/lostinsea/folia#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostinsea/folia.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "dompurify": "^3.0.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.9",
    "mermaid": "^11.16.0",
    "png-to-ico": "^3.0.1",
    "prismjs": "^1.30.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "io.github.lostinsea.folia",
    "productName": "Folia",
    "publish": [
      {
        "provider": "github",
        "owner": "lostinsea",
        "repo": "folia"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/index.html",
      "src/main.js",
      "src/renderer.js",
      "src/popup-preload.js",
      "src/styles.css",
      "assets/logo.ico",
      "assets/logo.png",
      "assets/logo_dark.png",
      "assets/app-icon.png",
      "assets/file-icon.png",
      "assets/file-icon.ico",
      "libs/**/*",
      "fonts/**/*",
      "src/utils.js",
      "src/mermaid-config.js",
      "src/context-menu-utils.js",
      "src/notification-helpers.js",
      "src/file-helpers.js",
      "src/emoji-map.js",
      "src/emoji-parser.js",
      "node_modules/**/*",
      "!**/*.md",
      "!dist/**/*",
      "!release-artifacts/**/*",
      "!linux-builds/**/*",
      "!tmp/**/*",
      "!.github/**/*",
      "!.git/**/*",
      "src/custom-styles.css",
      "src/custom-tabs.js",
      "src/custom-performance.js",
      "src/custom-theme.js",
      "src/custom-collapse.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.ico",
      "signtoolOptions": null,
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        }
      ],
      "artifactName": "Folia-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/app-icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "lostinsea <lostinsea@users.noreply.github.com>",
      "icon": "assets/app-icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "icon": "assets/file-icon.png"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "assets/file-icon.png"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "assets/file-icon.png"
        }
      ]
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "docs/images",
        "to": "docs/images"
      }
    ],
    "nsis": {
      "artifactName": "Folia-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folia",
      "runAfterFinish": true,
      "menuCategory": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
