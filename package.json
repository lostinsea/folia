{
  "name": "folia",
  "version": "1.0.0",
  "productName": "Folia",
  "description": "Folia - a fast, offline markdown viewer with tabs, Mermaid diagrams and live reload",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor-libs.js",
    "vendor": "node scripts/vendor-libs.js",
    "notices": "node scripts/generate-notices.js",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis",
    "build-all": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "build-linux-appimage": "electron-builder --linux AppImage",
    "build-linux-deb": "electron-builder --linux deb",
    "build-mac": "electron-builder --mac",
    "release": "node scripts/release.js",
    "test:tabs": "electron test-tab-refresh.js",
    "start-dev": "NODE_ENV=development electron .",
    "test:security": "electron test-render-security.js",
    "test:popups": "electron test-popup-security.js",
    "test:packaging": "node test-packaging.js",
    "test:migration": "node test-userdata-migration.js",
    "test:mermaid": "electron test-mermaid-render.js",
    "test:visual": "electron test-visual-utils-selfcheck.js",
    "test:startup": "electron test-startup-perf.js",
    "test:search": "electron test-search.js",
    "test:patch": "electron test-render-patch.js",
    "test:translate": "electron test-translate-network.js",
    "test": "npm run test:packaging && npm run test:migration && npm run test:startup && npm run test:tabs && npm run test:security && npm run test:popups && npm run test:visual && npm run test:search && npm run test:mermaid && npm run test:patch && npm run test:tables",
    "test:tables": "node --check test-table-display.js && electron test-table-display.js"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "mermaid",
    "folia"
  ],
  "author": {
    "name": "lostinsea"
  },
  "license": "MIT",
  "homepage": "https://github.com/lostinsea/markdown-viewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostinsea/markdown-viewer.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "dompurify": "^3.0.6",
    "electron-updater": "^6.1.7",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "marked": "^9.1.6",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "io.github.lostinsea.folia",
    "productName": "Folia",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "renderer.js",
      "popup-preload.js",
      "styles.css",
      "logo.ico",
      "logo.png",
      "logo_dark.png",
      "markdown_viewer_icon.png",
      "file-icon.png",
      "file-icon.ico",
      "libs/**/*",
      "fonts/**/*",
      "utils.js",
      "mermaid-config.js",
      "context-menu-utils.js",
      "notification-helpers.js",
      "file-helpers.js",
      "emoji-map.js",
      "emoji-parser.js",
      "node_modules/**/*",
      "!**/*.md",
      "!dist/**/*",
      "!release-artifacts/**/*",
      "!linux-builds/**/*",
      "!ss/**/*",
      "!tmp/**/*",
      "!.github/**/*",
      "!.git/**/*",
      "custom-styles.css",
      "custom-tabs.js",
      "custom-performance.js",
      "custom-theme.js",
      "custom-language.js",
      "custom-collapse.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.ico",
      "signtoolOptions": null,
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "icon": "file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "file-icon.ico",
          "role": "Viewer"
        }
      ],
      "artifactName": "Folia-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "markdown_viewer_icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "lostinsea <lostinsea@users.noreply.github.com>",
      "icon": "markdown_viewer_icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "icon": "file-icon.png"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "file-icon.png"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "file-icon.png"
        }
      ]
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ],
    "nsis": {
      "artifactName": "Folia-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folia",
      "runAfterFinish": true,
      "menuCategory": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt"
    }
  },
  "publish": null,
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
